      "settings": {
        "liquid": "<style>\n.comparison-table {\nwidth:100%;\noverflow-x:auto;\n}\n\n.comparison-table table {\nwidth:100%;\nborder-collapse:collapse;\nmin-width:900px;\nfont-family:Chakra Petch, sans-serif;\nfont-size:14px;\n}\n\n.comparison-table th,\n.comparison-table td {\nborder:1px solid #333;\npadding:12px;\ntext-align:left;\nvertical-align:top;\n}\n\n.comparison-table th {\nbackground:#e9e9e9;\nfont-weight:600;\n}\n\n.comparison-table td:first-child {\nfont-weight:600;\nwidth:220px;\n}\n\n@media (max-width:768px){\n\n.comparison-table table{\nfont-size:13px;\n}\n\n}\n</style>\n\n<div class=\"comparison-table\">\n\n<table>\n\n<thead>\n<tr>\n<th>Category</th>\n<th>Live fire capable</th>\n<th>Automated scoring</th>\n<th>Timing integration</th>\n<th>Data and reporting</th>\n<th>Range throughput</th>\n<th>Ongoing consumables</th>\n<th>Best fit</th>\n</tr>\n</thead>\n\n<tbody>\n\n<tr>\n<td>HIT IQ (DA Targets)</td>\n<td>Yes</td>\n<td>Yes</td>\n<td>Yes</td>\n<td>Yes</td>\n<td>High</td>\n<td>Low</td>\n<td>High</td>\n</tr>\n\n<tr>\n<td>Paper targets and manual scoring</td>\n<td>Yes</td>\n<td>No</td>\n<td>No</td>\n<td>No</td>\n<td>Low</td>\n<td>High</td>\n<td>Low</td>\n</tr>\n\n<tr>\n<td>Camera-based scoring apps (phone/webcam)</td>\n<td>No</td>\n<td>Partial</td>\n<td>Partial</td>\n<td>Partial</td>\n<td>Medium</td>\n<td>Medium</td>\n<td>Low</td>\n</tr>\n\n<tr>\n<td>Weapon-mounted sensor analytics tools</td>\n<td>Partial</td>\n<td>Partial</td>\n<td>Yes</td>\n<td>Yes</td>\n<td>Medium</td>\n<td>Low</td>\n<td>Medium</td>\n</tr>\n\n<tr>\n<td>Simulator / VR / judgemental training systems</td>\n<td>No</td>\n<td>Yes</td>\n<td>Yes</td>\n<td>Yes</td>\n<td>Medium</td>\n<td>Low</td>\n<td>Medium</td>\n</tr>\n\n<tr>\n<td>Legacy electronic scoring target systems</td>\n<td>Yes</td>\n<td>Partial</td>\n<td>Partial</td>\n<td>Partial</td>\n<td>Medium</td>\n<td>Medium</td>\n<td>Medium</td>\n</tr>\n\n</tbody>\n\n</table>\n\n</div>",
