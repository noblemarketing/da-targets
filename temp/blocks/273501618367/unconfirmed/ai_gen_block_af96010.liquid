{% doc %}
  @prompt
    Create a newsletter/email signup popup that appears after a short delay (e.g., 5 seconds) or on exit intent. The popup should include a headline like "Get 10% Off Your First Order", a brief subtext encouraging signup, an email input field, a submit button, and a close/dismiss button. After submission, show a success message with a discount code. The popup should only show once per session using localStorage, have a semi-transparent dark overlay background, and be styled to match a premium outdoor/sport brand aesthetic with bold visuals.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-newsletter-popup-{{ ai_gen_id }} {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    align-items: center;
    justify-content: center;
  }

  .ai-newsletter-popup-{{ ai_gen_id }}.active {
    display: flex;
  }

  .ai-newsletter-popup-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
  }

  .ai-newsletter-popup-container-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.popup_bg_color }};
    max-width: {{ block.settings.popup_width }}px;
    width: 90%;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
    z-index: 1;
  }

  .ai-newsletter-popup-content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
    text-align: center;
  }

  .ai-newsletter-popup-close-{{ ai_gen_id }} {
    position: absolute;
    top: 15px;
    right: 15px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    z-index: 2;
    transition: opacity 0.3s ease;
  }

  .ai-newsletter-popup-close-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-newsletter-popup-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    font-weight: {{ block.settings.headline_weight }};
    color: {{ block.settings.headline_color }};
    margin: 0 0 15px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-newsletter-popup-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 25px;
    line-height: 1.5;
  }

  .ai-newsletter-popup-form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .ai-newsletter-popup-input-{{ ai_gen_id }} {
    padding: 15px 20px;
    border: 2px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: 16px;
    background-color: {{ block.settings.input_bg_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-newsletter-popup-input-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.button_bg_color }};
  }

  .ai-newsletter-popup-button-{{ ai_gen_id }} {
    padding: 15px 30px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-newsletter-popup-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-newsletter-popup-success-{{ ai_gen_id }} {
    display: none;
  }

  .ai-newsletter-popup-success-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-newsletter-popup-success-message-{{ ai_gen_id }} {
    font-size: 18px;
    color: {{ block.settings.success_color }};
    margin-bottom: 20px;
    font-weight: 600;
  }

  .ai-newsletter-popup-discount-code-{{ ai_gen_id }} {
    display: inline-block;
    padding: 15px 30px;
    background-color: {{ block.settings.discount_bg_color }};
    color: {{ block.settings.discount_text_color }};
    font-size: 24px;
    font-weight: 700;
    border-radius: {{ block.settings.border_radius }}px;
    letter-spacing: 2px;
    margin-top: 10px;
    border: 2px dashed {{ block.settings.discount_border_color }};
  }

  .ai-newsletter-popup-error-{{ ai_gen_id }} {
    display: none;
    color: {{ block.settings.error_color }};
    font-size: 14px;
    margin-top: 10px;
  }

  .ai-newsletter-popup-error-{{ ai_gen_id }}.active {
    display: block;
  }

  @media screen and (max-width: 749px) {
    .ai-newsletter-popup-container-{{ ai_gen_id }} {
      max-width: 95%;
    }

    .ai-newsletter-popup-content-{{ ai_gen_id }} {
      padding: 30px 20px;
    }

    .ai-newsletter-popup-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.8 }}px;
    }

    .ai-newsletter-popup-discount-code-{{ ai_gen_id }} {
      font-size: 20px;
    }
  }
{% endstyle %}

<newsletter-popup-{{ ai_gen_id }}
  class="ai-newsletter-popup-{{ ai_gen_id }}"
  data-delay="{{ block.settings.popup_delay }}"
  data-exit-intent="{{ block.settings.enable_exit_intent }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-newsletter-popup-overlay-{{ ai_gen_id }}"></div>
  <div class="ai-newsletter-popup-container-{{ ai_gen_id }}">
    <button
      class="ai-newsletter-popup-close-{{ ai_gen_id }}"
      aria-label="Close popup"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="ai-newsletter-popup-content-{{ ai_gen_id }}">
      <div class="ai-newsletter-popup-form-wrapper-{{ ai_gen_id }}">
        <h2 class="ai-newsletter-popup-headline-{{ ai_gen_id }}">
          {{ block.settings.headline }}
        </h2>
        <div class="ai-newsletter-popup-subtext-{{ ai_gen_id }}">
          {{ block.settings.subtext }}
        </div>

        {%- form 'customer', id: 'ai-newsletter-form-' | append: ai_gen_id -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="ai-newsletter-popup-form-{{ ai_gen_id }}">
            <input
              type="email"
              name="contact[email]"
              class="ai-newsletter-popup-input-{{ ai_gen_id }}"
              placeholder="{{ block.settings.email_placeholder }}"
              aria-label="Email address"
              required
            >
            <button
              type="submit"
              class="ai-newsletter-popup-button-{{ ai_gen_id }}"
            >
              {{ block.settings.button_text }}
            </button>
          </div>
          <div class="ai-newsletter-popup-error-{{ ai_gen_id }}"></div>
        {%- endform -%}
      </div>

      <div class="ai-newsletter-popup-success-{{ ai_gen_id }}">
        <div class="ai-newsletter-popup-success-message-{{ ai_gen_id }}">
          {{ block.settings.success_message }}
        </div>
        {% if block.settings.discount_code != blank %}
          <div class="ai-newsletter-popup-discount-code-{{ ai_gen_id }}">
            {{ block.settings.discount_code }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</newsletter-popup-{{ ai_gen_id }}>

<script>
  (function() {
    class NewsletterPopup{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.delay = parseInt(this.dataset.delay) * 1000;
        this.exitIntent = this.dataset.exitIntent === 'true';
        this.storageKey = 'ai-newsletter-popup-{{ ai_gen_id }}-shown';
        this.closeButton = this.querySelector('.ai-newsletter-popup-close-{{ ai_gen_id }}');
        this.overlay = this.querySelector('.ai-newsletter-popup-overlay-{{ ai_gen_id }}');
        this.form = this.querySelector('#ai-newsletter-form-{{ ai_gen_id }}');
        this.formWrapper = this.querySelector('.ai-newsletter-popup-form-wrapper-{{ ai_gen_id }}');
        this.successMessage = this.querySelector('.ai-newsletter-popup-success-{{ ai_gen_id }}');
        this.errorMessage = this.querySelector('.ai-newsletter-popup-error-{{ ai_gen_id }}');
      }

      connectedCallback() {
        if (this.hasBeenShown()) {
          return;
        }

        this.setupEventListeners();
        this.schedulePopup();
      }

      hasBeenShown() {
        return sessionStorage.getItem(this.storageKey) === 'true';
      }

      markAsShown() {
        sessionStorage.setItem(this.storageKey, 'true');
      }

      setupEventListeners() {
        this.closeButton.addEventListener('click', () => this.closePopup());
        this.overlay.addEventListener('click', () => this.closePopup());

        this.form.addEventListener('submit', (e) => this.handleSubmit(e));

        if (this.exitIntent) {
          document.addEventListener('mouseout', (e) => this.handleExitIntent(e));
        }
      }

      schedulePopup() {
        setTimeout(() => {
          this.showPopup();
        }, this.delay);
      }

      handleExitIntent(e) {
        if (e.clientY <= 0 && !this.classList.contains('active')) {
          this.showPopup();
        }
      }

      showPopup() {
        if (!this.hasBeenShown()) {
          this.classList.add('active');
          this.markAsShown();
          document.body.style.overflow = 'hidden';
        }
      }

      closePopup() {
        this.classList.remove('active');
        document.body.style.overflow = '';
      }

      async handleSubmit(e) {
        e.preventDefault();
        this.errorMessage.classList.remove('active');

        const formData = new FormData(this.form);

        try {
          const response = await fetch(this.form.action, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          });

          if (response.ok) {
            this.formWrapper.style.display = 'none';
            this.successMessage.classList.add('active');
          } else {
            this.errorMessage.textContent = 'Something went wrong. Please try again.';
            this.errorMessage.classList.add('active');
          }
        } catch (error) {
          this.errorMessage.textContent = 'Network error. Please check your connection.';
          this.errorMessage.classList.add('active');
        }
      }
    }

    customElements.define('newsletter-popup-{{ ai_gen_id }}', NewsletterPopup{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Newsletter popup",
  "settings": [
    {
      "type": "header",
      "content": "Popup behavior"
    },
    {
      "type": "range",
      "id": "popup_delay",
      "label": "Delay before showing",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "enable_exit_intent",
      "label": "Enable exit intent",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "headline",
