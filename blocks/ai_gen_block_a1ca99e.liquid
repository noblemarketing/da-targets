    {
      "type": "range",
      "id": "body_size",
      "label": "Size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Color",
      "default": "#524e4d"
    },
    {
      "type": "range",
      "id": "body_spacing",
      "label": "Bottom spacing",
      "min": 0,
