{% doc %}
  @prompt
    Banner image for Desktop and Moble
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-banner-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-banner-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-banner-desktop-{{ ai_gen_id }} {
    display: block;
  }

  .ai-banner-mobile-{{ ai_gen_id }} {
    display: none;
  }

  .ai-banner-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    min-height: {{ block.settings.min_height_desktop }}px;
  }

  .ai-banner-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 600px;
    max-height: 400px;
  }

  .ai-banner-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-banner-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-banner-mobile-{{ ai_gen_id }} {
      display: block;
    }

    .ai-banner-placeholder-{{ ai_gen_id }} {
      min-height: {{ block.settings.min_height_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.image_desktop or block.settings.image_mobile %}
    {% if block.settings.banner_link != blank %}
      <a href="{{ block.settings.banner_link }}">
    {% endif %}

    <div class="ai-banner-desktop-{{ ai_gen_id }}">
      {% if block.settings.image_desktop %}
        <img
          src="{{ block.settings.image_desktop | image_url: width: 2000 }}"
          alt="{{ block.settings.image_desktop.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_desktop.width }}"
          height="{{ block.settings.image_desktop.height }}"
          class="ai-banner-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-banner-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-banner-empty-state-{{ ai_gen_id }}">
            Add a desktop image
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-banner-mobile-{{ ai_gen_id }}">
      {% if block.settings.image_mobile %}
        <img
          src="{{ block.settings.image_mobile | image_url: width: 1000 }}"
          alt="{{ block.settings.image_mobile.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_mobile.width }}"
          height="{{ block.settings.image_mobile.height }}"
          class="ai-banner-image-{{ ai_gen_id }}"
        >
      {% elsif block.settings.image_desktop %}
        <img
          src="{{ block.settings.image_desktop | image_url: width: 1000 }}"
          alt="{{ block.settings.image_desktop.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_desktop.width }}"
          height="{{ block.settings.image_desktop.height }}"
          class="ai-banner-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-banner-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-banner-empty-state-{{ ai_gen_id }}">
            Add a mobile image
          </div>
        </div>
      {% endif %}
    </div>

    {% if block.settings.banner_link != blank %}
      </a>
    {% endif %}
  {% else %}
    <div class="ai-banner-placeholder-{{ ai_gen_id }}">
      {{ 'image' | placeholder_svg_tag }}
      <div class="ai-banner-empty-state-{{ ai_gen_id }}">
        Add desktop and mobile images
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Banner image",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image"
    },
    {
      "type": "paragraph",
      "content": "If no mobile image is selected, the desktop image will be used on mobile devices."
    },
    {
      "type": "header",
      "content": "Settings"
    },
    {
      "type": "url",
      "id": "banner_link",
      "label": "Banner link"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "label": "Minimum height desktop",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 400
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Minimum height mobile",
      "min": 150,
      "max": 600,
      "step": 50,
      "unit": "px",
      "default": 300
    }
  ],
  "presets": [
    {
      "name": "Banner image"
    }
  ],
  "tag": null
}
{% endschema %}
