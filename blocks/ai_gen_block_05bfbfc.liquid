{% doc %}
  @prompt
    Create an FAQ for both mobile and desktop with a header and dropdowns for questions and answers
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-faq-container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
    display: block;
  }

  .ai-faq-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.header_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-faq-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.subtitle_spacing }}px;
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
  }

  .ai-faq-subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    font-size: {{ block.settings.subtitle_size }}px;
  }

  .ai-faq-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-faq-item-{{ ai_gen_id }} {
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-faq-item-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-faq-question-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.question_padding }}px 40px {{ block.settings.question_padding }}px 0;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: {{ block.settings.question_color }};
    font-size: {{ block.settings.question_size }}px;
    font-weight: {{ block.settings.question_weight }};
    transition: color 0.3s ease;
    position: relative;
  }

  .ai-faq-question-{{ ai_gen_id }}:hover {
    color: {{ block.settings.question_hover_color }};
  }

  .ai-faq-question-text-{{ ai_gen_id }} {
    flex: 1;
    padding-right: 20px;
  }

  .ai-faq-icon-{{ ai_gen_id }} {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 24px;
    height: 24px;
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  .ai-faq-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.icon_color }};
  }

  .ai-faq-question-{{ ai_gen_id }}[aria-expanded="true"] .ai-faq-icon-{{ ai_gen_id }} {
    transform: translateY(-50%) rotate(180deg);
  }

  .ai-faq-answer-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
    padding: 0;
  }

  .ai-faq-answer-{{ ai_gen_id }}.active {
    max-height: 1000px;
    padding: 0 0 {{ block.settings.answer_padding }}px 0;
  }

  .ai-faq-answer-content-{{ ai_gen_id }} {
    color: {{ block.settings.answer_color }};
    font-size: {{ block.settings.answer_size }}px;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-faq-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-faq-question-{{ ai_gen_id }} {
      font-size: {{ block.settings.question_size | times: 0.9 }}px;
    }

    .ai-faq-answer-content-{{ ai_gen_id }} {
      font-size: {{ block.settings.answer_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<faq-accordion-{{ ai_gen_id }} class="ai-faq-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank or block.settings.subtitle != blank %}
    <div class="ai-faq-header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-faq-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <div class="ai-faq-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
      {% endif %}
    </div>
  {% endif %}

  <ul class="ai-faq-list-{{ ai_gen_id }}">
    {% for i in (1..10) %}
      {% assign question_key = 'question_' | append: i %}
      {% assign answer_key = 'answer_' | append: i %}
      {% assign question = block.settings[question_key] %}
      {% assign answer = block.settings[answer_key] %}

      {% if question != blank and answer != blank %}
        <li class="ai-faq-item-{{ ai_gen_id }}">
          <button
            class="ai-faq-question-{{ ai_gen_id }}"
            aria-expanded="false"
            aria-controls="ai-faq-answer-{{ ai_gen_id }}-{{ i }}"
          >
            <span class="ai-faq-question-text-{{ ai_gen_id }}">{{ question }}</span>
            <span class="ai-faq-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </button>
          <div
            class="ai-faq-answer-{{ ai_gen_id }}"
            id="ai-faq-answer-{{ ai_gen_id }}-{{ i }}"
          >
            <div class="ai-faq-answer-content-{{ ai_gen_id }}">{{ answer }}</div>
          </div>
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</faq-accordion-{{ ai_gen_id }}>

<script>
  (function() {
    class FaqAccordion{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.questions = this.querySelectorAll('.ai-faq-question-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.questions.forEach((question) => {
          question.addEventListener('click', () => {
            const answer = question.nextElementSibling;
            const isExpanded = question.getAttribute('aria-expanded') === 'true';

            if (isExpanded) {
              this.closeAnswer(question, answer);
            } else {
              this.openAnswer(question, answer);
            }
          });
        });
      }

      openAnswer(question, answer) {
        question.setAttribute('aria-expanded', 'true');
        answer.classList.add('active');
      }

      closeAnswer(question, answer) {
        question.setAttribute('aria-expanded', 'false');
        answer.classList.remove('active');
      }
    }

    customElements.define('faq-accordion-{{ ai_gen_id }}', FaqAccordion{{ ai_gen_id }});
  })();
</script>

