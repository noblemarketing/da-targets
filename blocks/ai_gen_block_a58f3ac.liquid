{% doc %}
  @prompt
    Video with text and button above, make mobile format too, make heading above the video and the button below, move button under description, move all text under video, create more space above video
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-text-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
    padding-top: {{ block.settings.top_spacing }}px;
  }

  .ai-video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    overflow: hidden;
    background-color: #000000;
    margin-bottom: {{ block.settings.section_spacing }}px;
  }

  .ai-video-element-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-video-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-video-footer-{{ ai_gen_id }} {
    padding: {{ block.settings.footer_padding }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-video-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.text_spacing }}px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .ai-video-text-content-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    margin: 0 0 {{ block.settings.button_spacing }}px;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-video-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    transition: all 0.3s ease;
  }

  .ai-video-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-video-text-{{ ai_gen_id }} {
      width: 100%;
      padding-top: {{ block.settings.mobile_top_spacing }}px;
    }

    .ai-video-wrapper-{{ ai_gen_id }} {
      {% if block.settings.mobile_aspect_ratio == 'square' %}
        padding-bottom: 100%;
      {% elsif block.settings.mobile_aspect_ratio == 'portrait' %}
        padding-bottom: 133%;
      {% elsif block.settings.mobile_aspect_ratio == 'landscape' %}
        padding-bottom: 75%;
      {% else %}
        padding-bottom: 56.25%;
      {% endif %}
      margin-bottom: {{ block.settings.mobile_section_spacing }}px;
    }

    .ai-video-footer-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_footer_padding }}px;
      text-align: {{ block.settings.mobile_text_alignment }};
    }

    .ai-video-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-video-text-content-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
      margin-bottom: {{ block.settings.mobile_button_spacing }}px;
    }

    .ai-video-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_button_font_size }}px;
      padding: {{ block.settings.mobile_button_padding_vertical }}px {{ block.settings.mobile_button_padding_horizontal }}px;
    }
  }
{% endstyle %}

<video-with-text-{{ ai_gen_id }}
  class="ai-video-text-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-video-wrapper-{{ ai_gen_id }}">
    {% if block.settings.video_url != blank %}
      <video
        class="ai-video-element-{{ ai_gen_id }}"
        {% if block.settings.autoplay %}autoplay{% endif %}
        {% if block.settings.loop %}loop{% endif %}
        {% if block.settings.muted %}muted{% endif %}
        playsinline
      >
        <source src="{{ block.settings.video_url }}" type="video/mp4">
        Your browser does not support the video tag.
      </video>
    {% else %}
      <div class="ai-video-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  {% if block.settings.heading != blank or block.settings.text != blank or block.settings.button_text != blank %}
    <div class="ai-video-footer-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-video-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="ai-video-text-content-{{ ai_gen_id }}">{{ block.settings.text }}</div>
      {% endif %}

      {% if block.settings.button_text != blank and block.settings.button_link != blank %}
        <a
          href="{{ block.settings.button_link }}"
          class="ai-video-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  {% endif %}
</video-with-text-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoWithText{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const video = this.querySelector('.ai-video-element-{{ ai_gen_id }}');
        if (video) {
          video.addEventListener('loadeddata', function() {
            video.play().catch(function(error) {
              console.log('Video autoplay prevented:', error);
            });
          });
        }
      }
    }

    customElements.define('video-with-text-{{ ai_gen_id }}', VideoWithText{{ ai_gen_id }});
  })();
</script>

