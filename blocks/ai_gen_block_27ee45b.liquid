{% doc %}
  @prompt
    Make a contact form that has Full Name
    Email Address
    Phone Number
    Organization/Company Name
    
    Message and is sent to ryan@da-targets.com
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-form-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.form_padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-contact-form__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-contact-form__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    text-align: {{ block.settings.text_align }};
  }

  .ai-contact-form__description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.description_spacing }}px;
    text-align: {{ block.settings.text_align }};
  }

  .ai-contact-form__field-group-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.field_spacing }}px;
  }

  .ai-contact-form__label-{{ ai_gen_id }} {
    display: block;
    margin-bottom: 8px;
    color: {{ block.settings.label_color }};
    font-weight: 500;
  }

  .ai-contact-form__input-{{ ai_gen_id }},
  .ai-contact-form__textarea-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.input_text_color }};
    font-size: 16px;
    transition: border-color 0.3s ease;
  }

  .ai-contact-form__input-{{ ai_gen_id }}:focus,
  .ai-contact-form__textarea-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.input_focus_border_color }};
  }

  .ai-contact-form__textarea-{{ ai_gen_id }} {
    min-height: {{ block.settings.message_height }}px;
    resize: vertical;
  }

  .ai-contact-form__button-{{ ai_gen_id }} {
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
    width: 100%;
  }

  .ai-contact-form__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-contact-form__success-{{ ai_gen_id }} {
    padding: 16px;
    margin-bottom: {{ block.settings.field_spacing }}px;
    background-color: {{ block.settings.success_bg_color }};
    color: {{ block.settings.success_text_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    text-align: center;
  }

  .ai-contact-form__error-{{ ai_gen_id }} {
    padding: 16px;
    margin-bottom: {{ block.settings.field_spacing }}px;
    background-color: {{ block.settings.error_bg_color }};
    color: {{ block.settings.error_text_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
  }

  .ai-contact-form__error-item-{{ ai_gen_id }} {
    margin: 4px 0;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form-{{ ai_gen_id }} {
      padding: {{ block.settings.form_padding | times: 0.6 }}px;
    }
  }
{% endstyle %}

<contact-form-{{ ai_gen_id }}
  class="ai-contact-form-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {%- form 'contact' -%}
    <input
      type="hidden"
      name="contact[recipient]"
      value="ryan@da-targets.com"
    >
    
    <div class="ai-contact-form__container-{{ ai_gen_id }}">
      {%- if block.settings.heading != blank -%}
        <h2 class="ai-contact-form__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {%- endif -%}

      {%- if block.settings.description != blank -%}
        <div class="ai-contact-form__description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {%- endif -%}

      {%- if form.posted_successfully? -%}
        <div
          id="ai-contact-form-success-{{ ai_gen_id }}"
          class="ai-contact-form__success-{{ ai_gen_id }}"
        >
          {{ block.settings.success_message }}
        </div>
      {%- endif -%}

      {%- if form.errors -%}
        <div
          id="ai-contact-form-error-{{ ai_gen_id }}"
          class="ai-contact-form__error-{{ ai_gen_id }}"
        >
          <p><strong>{{ block.settings.error_heading }}</strong></p>
          {%- for field in form.errors -%}
            <div class="ai-contact-form__error-item-{{ ai_gen_id }}">
              {%- if field == 'form' -%}
                {{ form.errors.messages[field] }}
              {%- else -%}
                {{ form.errors.messages[field] }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="ai-contact-form__field-group-{{ ai_gen_id }}">
        <label
          for="ai-contact-name-{{ ai_gen_id }}"
          class="ai-contact-form__label-{{ ai_gen_id }}"
        >
          {{ block.settings.name_label }}
          {%- if block.settings.show_required_asterisk -%}<span style="color: {{ block.settings.error_text_color }};">*</span>{%- endif -%}
        </label>
        <input
          type="text"
          id="ai-contact-name-{{ ai_gen_id }}"
          name="contact[{{ block.settings.name_label }}]"
          class="ai-contact-form__input-{{ ai_gen_id }}"
          value="{% if form.name %}{{ form.name }}{% endif %}"
          placeholder="{{ block.settings.name_placeholder }}"
          required
          aria-required="true"
          {% if form.errors contains 'name' %}
            aria-invalid="true"
            aria-describedby="ai-contact-form-error-{{ ai_gen_id }}"
          {% endif %}
        >
      </div>

      <div class="ai-contact-form__field-group-{{ ai_gen_id }}">
        <label
          for="ai-contact-email-{{ ai_gen_id }}"
          class="ai-contact-form__label-{{ ai_gen_id }}"
        >
          {{ block.settings.email_label }}
          {%- if block.settings.show_required_asterisk -%}<span style="color: {{ block.settings.error_text_color }};">*</span>{%- endif -%}
        </label>
        <input
          type="email"
          id="ai-contact-email-{{ ai_gen_id }}"
          name="contact[email]"
          class="ai-contact-form__input-{{ ai_gen_id }}"
          value="{% if form.email %}{{ form.email }}{% endif %}"
          placeholder="{{ block.settings.email_placeholder }}"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          required
          aria-required="true"
          {% if form.errors contains 'email' %}
            aria-invalid="true"
            aria-describedby="ai-contact-form-error-{{ ai_gen_id }}"
          {% endif %}
        >
      </div>

      <div class="ai-contact-form__field-group-{{ ai_gen_id }}">
        <label
          for="ai-contact-phone-{{ ai_gen_id }}"
          class="ai-contact-form__label-{{ ai_gen_id }}"
        >
          {{ block.settings.phone_label }}
          {%- if block.settings.show_required_asterisk -%}<span style="color: {{ block.settings.error_text_color }};">*</span>{%- endif -%}
        </label>
        <input
          type="tel"
          id="ai-contact-phone-{{ ai_gen_id }}"
          name="contact[{{ block.settings.phone_label }}]"
          class="ai-contact-form__input-{{ ai_gen_id }}"
          value="{% if form.phone %}{{ form.phone }}{% endif %}"
          placeholder="{{ block.settings.phone_placeholder }}"
          autocomplete="tel"
          required
          aria-required="true"
          {% if form.errors contains 'phone' %}
            aria-invalid="true"
            aria-describedby="ai-contact-form-error-{{ ai_gen_id }}"
          {% endif %}
        >
      </div>

      <div class="ai-contact-form__field-group-{{ ai_gen_id }}">
        <label
          for="ai-contact-company-{{ ai_gen_id }}"
          class="ai-contact-form__label-{{ ai_gen_id }}"
        >
          {{ block.settings.company_label }}
          {%- if block.settings.show_required_asterisk -%}<span style="color: {{ block.settings.error_text_color }};">*</span>{%- endif -%}
        </label>
        <input
          type="text"
          id="ai-contact-company-{{ ai_gen_id }}"
          name="contact[{{ block.settings.company_label }}]"
          class="ai-contact-form__input-{{ ai_gen_id }}"
          value="{% if form.company %}{{ form.company }}{% endif %}"
          placeholder="{{ block.settings.company_placeholder }}"
          required
          aria-required="true"
          {% if form.errors contains 'company' %}
            aria-invalid="true"
            aria-describedby="ai-contact-form-error-{{ ai_gen_id }}"
          {% endif %}
        >
      </div>

      <div class="ai-contact-form__field-group-{{ ai_gen_id }}">
        <label
          for="ai-contact-message-{{ ai_gen_id }}"
          class="ai-contact-form__label-{{ ai_gen_id }}"
        >
          {{ block.settings.message_label }}
          {%- if block.settings.show_required_asterisk -%}<span style="color: {{ block.settings.error_text_color }};">*</span>{%- endif -%}
        </label>
        <textarea
          id="ai-contact-message-{{ ai_gen_id }}"
          name="contact[body]"
          class="ai-contact-form__textarea-{{ ai_gen_id }}"
          placeholder="{{ block.settings.message_placeholder }}"
          required
          aria-required="true"
          {% if form.errors contains 'body' %}
            aria-invalid="true"
            aria-describedby="ai-contact-form-error-{{ ai_gen_id }}"
          {% endif %}
        >{% if form.body %}{{ form.body }}{% endif %}</textarea>
      </div>

      <button
        type="submit"
        class="ai-contact-form__button-{{ ai_gen_id }}"
      >
        {{ block.settings.button_text }}
      </button>
    </div>
  {%- endform -%}
</contact-form-{{ ai_gen_id }}>

<script>
  (function() {
    class ContactForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const form = this.querySelector('form');
        if (form) {
          form.addEventListener('submit', this.handleSubmit.bind(this));
        }
      }

      handleSubmit(event) {
        const requiredFields = this.querySelectorAll('[required]');
        let isValid = true;

        requiredFields.forEach(field => {
          if (!field.value.trim()) {
            isValid = false;
            field.setAttribute('aria-invalid', 'true');
          } else {
            field.removeAttribute('aria-invalid');
          }
        });

        if (!isValid) {
          event.preventDefault();
        }
      }
    }

    customElements.define('contact-form-{{ ai_gen_id }}', ContactForm{{ ai_gen_id }});
  })();
</script>

