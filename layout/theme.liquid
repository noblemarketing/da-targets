<!doctype html>
<html class="no-js " lang="{{ shop.locale }}">
  <head>
 {%- render 'ecom_header' -%}
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_header_bg }}">
    <link rel="preconnect" href="//cdn.shopify.com" crossorigin>
    <link rel="dns-prefetch" href="//cdn.shopify.com">
    <link rel="preconnect" href="//fonts.shopify.com" crossorigin>
    <link rel="dns-prefetch" href="//fonts.shopify.com">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- if settings.favicon != blank -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" type="image/png">
    {%- endif -%}

    <title>
      {{ page_title }}
      {% if current_tags %}
        {% assign meta_tags = current_tags | join: ', ' %}
        &ndash;
        {{ 'general.meta.tags' | t: tags: meta_tags }}
      {% endif %}
      {% if current_page != 1 %}
        &ndash;
        {{ 'general.meta.page' | t: page: current_page }}
      {% endif %}
      {% unless page_title contains shop.name %}
        &ndash;
        {{ shop.name }}
      {% endunless %}
    </title>
   
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
      {% else %}
      <meta name="description" content="{{ settings.meta_description | escape }}">
    {%- endif -%}
    
    {%- render 'social-meta-tags' -%}
    {%- render 'header-css' -%}
      <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    {{ content_for_header }}

    <script defer data-domain="da-targets.com" src="https://plausible.io/js/script.revenue.js"></script>
    
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-PWWJH7FL');</script>
    <!-- End Google Tag Manager -->

    <!-- Hotjar Tracking Code for https://www.da-targets.com -->
    <script>
      (function(h,o,t,j,a,r){
          h.hj=h.hj||function(){(h.hj.q=h.hj.q||[]).push(arguments)};
          h._hjSettings={hjid:6390931,hjsv:6};
          a=o.getElementsByTagName('head')[0];
          r=o.createElement('script');r.async=1;
          r.src=t+h._hjSettings.hjid+j+h._hjSettings.hjsv;
          a.appendChild(r);
      })(window,document,'https://static.hotjar.com/c/hotjar-','.js?sv=');
    </script>
  </head>
  <body class="template-{{ template | replace: '.', ' ' | truncatewords: 1, '' | handle }} body-theme {% if settings.productpage == 'product-2' or settings.productpage == 'product-6' or settings.productpage == 'product-7' %} product-hide-breadcrumb {% endif %}">

    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PWWJH7FL"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

   {% assign lazy = false %}
    <img {% if lazy %} loading = "lazy" {% endif %} width="99998" height="99999" alt="index" style="pointer-events: none; position: absolute; top: 0; left: 0; width: 98vw; height: 99vh; max-width: 98vw; max-height: 99vh;" src="data:image/svg+xml;base64,">
    {%- render 'loading' -%}
    {%- sections 'header-group' -%}
    <div class="page-container page-element is-moved-by-drawer">
      {%- render 'breadcrumb' -%}
      <main class="main-content" id="MainContent" role="main">
        {%- if settings.enable_animationscroll -%}
          <div id="js-scroll">
          {% endif %}
          {%- if settings.enable_animationscroll -%}
            <div data-scroll-section>
            {% endif %}
            {%- render 'slideshow' -%}
            {%- if settings.enable_animationscroll -%}
            </div>
          {% endif %}
          {{ content_for_layout }}
          {%- if settings.enable_animationscroll -%}
          </div>
        {% endif %}
      </main>
    {%- sections 'footer-group' -%}
     {%- liquid
      if template == 'index' or request.design_mode
      section 'pnewsletter'
      endif
      section 'product-suggest'
      section 'cookie-policy'
      section 'custom-color'
     -%}
    </div>
    {%- liquid
      render 'back-to-top' 
      render 'menu-mobile' 
      render 'bottom-contents' 
      render 'quickview' 
      render 'popup-compare' 
      render 'header-js' 
    -%}
   <style>
    .variant-option-select-custom .custom_variant:not(.da-inline-warm-weather-variant):hover { color: white; background: black; }
    .variant-option-select-custom .custom_variant.da-inline-warm-weather-variant:hover { color: #fff !important; background: #ed6c02 !important; border-color: #ed6c02 !important; }
    .custom_variant.btn-0{
    margin-bottom:5px !important;
    
    }
    .custom_variant.selected:not(.da-inline-warm-weather-variant) { color: white; background: black; }
    .custom_variant.da-inline-warm-weather-variant.selected { color: #fff !important; background: #ed6c02 !important; border-color: #ed6c02 !important; }
   </style>
  {%- render "ecom_footer"-%}</body>
</html>