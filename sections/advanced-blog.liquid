<!-- advanced-blog.liquid -->
<style>
@media (min-width: 768px) {
  .customstyle{{ section.id }} .bloglist,
  .customstyle{{ section.id }} .bloglist-item ,
  .customstyle{{ section.id }} .bloglist-item > div > .blog__item--3 ,
  .customstyle{{ section.id }} .bloglist-item > div > .blog__item--3 .content-block__image ,
  .customstyle{{ section.id }} .bloglist-item > div > .blog__item--3 .content-block__image a ,
  .customstyle{{ section.id }} .bloglist-item > div > .blog__item--3 .content-block__image a .article__photo-container ,
  .customstyle{{ section.id }} .bloglist-item > div > .blog__item--3 .content-block__image a .article__photo-container .article__photo-wrapper ,
  .customstyle{{ section.id }} .bloglist-item > div {
    height: 100%;
  }
}
.customstyle{{ section.id }} .bloglist-item > div > .blog__item--3 .content-block__image a {
  display: block;
}
.customstyle{{ section.id }} h4.blog__title-link {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
</style>
<div class="customstyle{{ section.id }} blog-section{{section.id}}" data-aos="{{ section.settings.animation }}">
  {%- render 'style-section' -%}
<div class="{{ section.settings.setwidth }}">
  <div class="section-block">
    {%- render 'section-heading' -%}

    <div class="bloglist-wrapper dots-negative mt-40" data-aos="{{ section.settings.animation }}">

        <div class="row">
        {%- for block in section.blocks -%}
            {%- liquid
                case block.settings.width 
                when 'auto' 
                assign block_width = 'col-lg col-12' 
                when '20%' 
                assign block_width = 'col-1-5 col-md-6 col-12' 
                when '25%' 
                assign block_width = 'col-lg-3 col-md-3 col-12' 
                when '33%' 
                assign block_width = 'col-lg-4 col-md-4 ' 
                when '41%' 
                assign block_width = 'col-lg-5 col-md-12 ' 
                when '50%' 
                assign block_width = 'col-lg-6 ' 
                when '58%' 
                assign block_width = 'col-lg-7 col-md-12 ' 
                when '66%' 
                assign block_width = 'col-lg-8 col-md-12 ' 
                when '75%' 
                assign block_width = 'col-lg-9 col-md-9 col-12 ' 
                when '100%' 
                assign block_width = 'col-12 ' 
                endcase 
            -%}
            <div class="{{ block_width }}" {{ block.shopify_attributes }}>

                <div class="bloglist mb-md-0 mb-3" id="Bloglist-{{ block.id }}">
                  {%- assign blog = blogs[block.settings.blog] -%}
                  {%- assign limit = block.settings.limit -%}
                  {%- if blog != blank -%}
                  {%- for article in blog.articles limit: limit -%}
                  <div class="bloglist-item">
                    <div data-aos="{{ section.settings.animation }}"  data-aos-delay="{{ forloop.index | times: 100 }}">
                      {%- liquid
                        case block.settings.item_style
                        when 'blog-1'
                          render 'blog-grid-1' , settings: block.settings , article : article, image_size : block.settings.image_size, enable_btn_blog : block.settings.enable_btn_blog, enable_btn_line: block.settings.enable_btn_line, enable_date : block.settings.enable_date, enable_tag : block.settings.enable_tag, enable_comment: block.settings.enable_comment, enable_short : block.settings.enable_short
                        when 'blog-3'
                          render 'blog-grid-3' , settings: block.settings , article : article, image_size : block.settings.image_size, enable_btn_blog : block.settings.enable_btn_blog, enable_btn_line: block.settings.enable_btn_line, enable_date : block.settings.enable_date, enable_tag : block.settings.enable_tag, enable_comment: block.settings.enable_comment, enable_short : block.settings.enable_short
                        when 'blog-5'
                          render 'blog-grid-5', settings: block.settings , article : article, image_size : block.settings.image_size, enable_btn_blog : block.settings.enable_btn_blog, enable_btn_line: block.settings.enable_btn_line, enable_date : block.settings.enable_date, enable_tag : block.settings.enable_tag, enable_comment: block.settings.enable_comment, enable_short : block.settings.enable_short
                        when 'blog-6'
                          render 'blog-grid-6', settings: block.settings , article : article, image_size : block.settings.image_size, enable_btn_blog : block.settings.enable_btn_blog, enable_btn_line: block.settings.enable_btn_line, enable_date : block.settings.enable_date, enable_tag : block.settings.enable_tag, enable_comment: block.settings.enable_comment, enable_short : block.settings.enable_short
                        when 'blog-7'
                          render 'blog-grid-7', settings: block.settings , article : article, image_size : block.settings.image_size, enable_btn_blog : block.settings.enable_btn_blog, enable_btn_line: block.settings.enable_btn_line, enable_date : block.settings.enable_date, enable_tag : block.settings.enable_tag, enable_comment: block.settings.enable_comment, enable_short : block.settings.enable_short
                        else
                          render 'blog-grid-blank'
                        endcase
                      -%}
                    </div>
                  </div>
                  {%- endfor -%}
                  {%- else -%}
                  {%- for i in (1..limit) -%}
                  <div class="bloglist-item col">
                    <div data-aos="{{ section.settings.animation }}"  data-aos-delay="{{ forloop.index | times: 100 }}">
                    {%- render 'blog-grid-blank' -%}
                  </div>
                  </div>
                  {%- endfor -%}
                  {%- endif -%}
                </div>

            </div>
        {%- endfor -%}
        </div>


    </div>

    {%- render 'section-bot' -%}
  </div>
</div>
</div>

