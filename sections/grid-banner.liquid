<!-- grid-banner.liquid -->

<style>
  {%- if section.settings.show_overlay %}
    {% assign hex2rgb_hex = section.settings.bg_overlay %}
    .customstyle{{ section.id }} .banner-theme .banner-overlay{
      position: absolute;
      top:0;
      right:0;
      bottom:0;
      left: 0;
      {%- if section.settings.gradient_overlay -%}
        background:linear-gradient(180deg, rgb({{ hex2rgb_hex.red }}, {{ hex2rgb_hex.green }}, {{ hex2rgb_hex.blue }}, 0) 0%, rgb({{ hex2rgb_hex.red }}, {{ hex2rgb_hex.green }}, {{ hex2rgb_hex.blue }},{{ section.settings.opacity_overlay }}) 100%);
      {%- else -%}
        background-color: rgb({{ hex2rgb_hex.red }}, {{ hex2rgb_hex.green }}, {{ hex2rgb_hex.blue }}, {{ section.settings.opacity_overlay }});
      {%- endif -%}
      opacity: 1;
      z-index: 1;
    }
  {%- endif -%}
  .customstyle{{ section.id }} .subtop {
    writing-mode: vertical-lr;
    writing-mode: vertical-lr;
    font-size: 16px;
    font-weight: 900;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-right: 21px;
    line-height: 1;
    margin-top: 3px;
  }
  .customstyle{{ section.id }} h3.h2 {
    line-height: 1;
    -webkit-text-stroke: 2px var(--g-color-heading);
    color: transparent;
    font-size: 80px;
    line-height: 1;
    margin: 0 0 6px!important;
  }
  .customstyle{{ section.id }} .rte-setting.txt-body {
    font-size: 20px;
    text-transform: uppercase;
    font-family: var(--g-font-1);
    font-weight: 700;
  }
  .customstyle{{ section.id }} .grid-banner-btn {
    opacity: 0;
    transform: translateY(25px);
    -ms-transition: all 0.4s ease;
    -o-transition: all 0.4s ease;
    -moz-transition: all 0.4s ease;
    -webkit-transition: all 0.4s ease;
    transition: all 0.4s ease;
  }
  .customstyle{{ section.id }} .banner-theme:hover .grid-banner-btn {
    opacity: 1;
    transform: translateY(0);
  }
  .customstyle{{ section.id }} .banner-theme::before {
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
    bottom: 0;
    left: 0;
    z-index: 1;
    transition: all 0.4s ease;
  }
  .customstyle{{ section.id }} .banner-theme:hover::before {
    background-color: #00000067;
  }
  
  /* Make banner overlay clickable by allowing pointer events to pass through text content */
  .customstyle{{ section.id }} .banner-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    cursor: default;
  }
  
  .customstyle{{ section.id }} figcaption {
    pointer-events: none;
  }
  
  .customstyle{{ section.id }} figcaption .btn {
    pointer-events: auto;
    cursor: pointer;
  }
  {%- for block in section.blocks -%}
    {% if block.settings.vertical == 'top' %}
    .figcaption--{{ block.id }} .btn {
      position: absolute;
      bottom: 0;
      left: 0;
    }
    {% endif %}
  {%- endfor -%}

  /* THEME BOTTOM LEFT */
  .banner-theme-bottom.banner-theme-left figcaption {
    padding: 0;
  }
  .banner-theme-bottom.banner-theme-left figcaption > div {
    padding: 20px 0 20px 30px;
    backdrop-filter: blur(10px);
    margin: 30px;
  }
  @media (max-width: 1199px) {
    .banner-theme-bottom.banner-theme-left figcaption > div {
      padding: 20px 0 20px 10px;
      margin: 10px;
    }
  }
  @media (max-width: 480px) {
    .customstyle{{ section.id }} .banner-theme img {
      min-height: 300px;
      object-fit: cover;
    }
    .customstyle{{ section.id }} h3.h2 {
      font-size: 50px;
      margin: 0 0 6px!important;
    }
  }
</style>

<div class="customstyle{{ section.id }}" data-aos="{{ section.settings.animation }}" >
  {%- render 'style-section' -%}
<div class="{{ section.settings.setwidth }}">
  <div class="section-block">
    {%- render 'section-heading' -%}
    <div class="row {% if section.settings.no_gutter %}no-gutters{% endif %}">
      {%- for block in section.blocks -%}
      {%- assign text_colorsub = block.settings.colorsub -%}
      {%- assign text_colorheading = block.settings.colorheading -%}
      {%- assign text_color = block.settings.colordef -%}

        {%- liquid
          case block.settings.width 
          when 'auto' 
            assign block_width = 'col-lg col-12' 
          when '20%' 
            assign block_width = 'col-1-5 col-md-6 col-12' 
          when '25%' 
            assign block_width = 'col-lg-3 col-md-6 col-12' 
          when '33%' 
            assign block_width = 'col-lg-4 col-md-4 ' 
          when '41%' 
            assign block_width = 'col-lg-5 col-md-12 ' 
          when '50%' 
            assign block_width = 'col-lg-6 ' 
          when '58%' 
            assign block_width = 'col-lg-7 col-md-12 ' 
          when '66%' 
            assign block_width = 'col-lg-8 col-md-12 ' 
          when '75%' 
            assign block_width = 'col-lg-9 col-md-9 col-12 ' 
          when '100%' 
            assign block_width = 'col-12 ' 
        endcase 
        -%}
        <div class="{{ block_width }}" {{ block.shopify_attributes }}>
          <div {{ block.shopify_attributes }} data-aos="{{ section.settings.animation }}" data-aos-delay="{{ forloop.index | times: 100 }}">
    
            <figure class="mb-4 mb-lg-0 banner-theme hv-image-saturate banner-theme-{{ block.settings.vertical }} banner-theme-{{ block.settings.horizontal }} text-{{ block.settings.text_align }} {% if section.settings.no_gutter %}m-0{% endif %} banner-theme-{{ block.id }}"
              style="{% if text_color != 'transparent' %}
                --g-font-color-subtop: {{ text_colorsub }};
                --g-color-heading :  {{ text_colorheading }};
                --color-body-text : {{ text_color }};
                --color-body-text-rgb: {{ text_color.red }}, {{ text_color.green }},  {{ text_color.blue }} ;
              {% endif %}
              --g-figcaption-des: {{ block.settings.bg_color }};
              --g-figcaption-op: {{ block.settings.opacity_bg }};" >
              {%- if block.settings.image != blank -%}
              <img 
                src="{{ block.settings.image | image_url: width: 1, height: 1 }}" 
                class="lazyload transition scale-in {% if block.settings.image_mobile != blank %} d-none d-lg-block {% endif %}" 
                data-src="{{ block.settings.image | image_url: width: 1920 }}"
                loading="lazy"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}">
                {%- if block.settings.image_mobile != blank -%}
                <img 
                  src="{{ block.settings.image_mobile | image_url: width: 1, height: 1 }}" 
                  class="lazyload transition  {% if block.settings.image_mobile != blank %} d-lg-none {% endif %}" 
                  data-src="{{ block.settings.image_mobile | image_url: width: 1920 }}"
                  loading="lazy"
                  width="{{ block.settings.image_mobile.width }}"
                  height="{{ block.settings.image_mobile.height }}">
                {%- endif -%}
              <a class="banner-overlay" href="{{ block.settings.button_link | default: "#" }}"></a>
              {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
              <figcaption class="figcaption--{{ block.id }} {% if block.settings.vertical == 'top' %}h-100{% endif %}">
                    <div class="position-relative {% if block.settings.vertical == 'top' %}h-100{% endif %}">
                      <div class="bg-des"></div>
                      <div class="position-relative h-100 d-flex align-items-start {% if block.settings.opacity_bg > 0 %} p-4 {% endif %}" style="z-index: 3;">
                        {%- if block.settings.subtitle != blank -%}
                          <div class="subtop">{{ block.settings.subtitle }}</div>
                        {%- endif -%}
                        <div class="grid-banner_wp">
                          {%- if block.settings.title != blank -%}
                          <h3 class="{% if block.settings.description != blank or block.settings.button_text != blank %} mb-2 {% endif %} {{ block.settings.size_text }} ">{{ block.settings.title }}</h3>
                          {%- endif -%}
                          {%- if block.settings.description != blank -%}
                            <style>
                                .rte-setting.txt-body h5 {
                                  color: var(--color-body-text);
                                }
                            </style>
                            <div class="rte-setting txt-body">{{ block.settings.description }}</div>
                          {%- endif -%}
                          {%- if block.settings.button_text != blank -%}
                            <style>
                              .btn-theme.btn-{{ block.id }}{
                                color:{{ block.settings.color_button }};
                                border: 1px solid {{ block.settings.bg_button }};
                                background-color:{{ block.settings.bg_button }};
                              }
                              .btn-theme.btn-{{ block.id }}:hover{
                                color:{{ block.settings.color_button_hover }};
                                border-color:{{ block.settings.bg_button_hover }};
                                {% unless settings.enable_button_hover %}
                                  background-color:{{ block.settings.bg_button_hover }};
                                {% endunless %}
                              }
                              .btn-theme.btn-{{ block.id }}::before{
                                background-color:{{ block.settings.bg_button_hover }};
                              }
                              .btn-outline.btn-{{ block.id }}{
                                color:{{ block.settings.color_button }};
                                border: 2px solid {{ block.settings.bg_button }};
                                background-color:transparent;
                              }
                              .btn-outline.btn-{{ block.id }}:hover{
                                border-color:{{ block.settings.bg_button_hover }};
                                color:{{ block.settings.color_button_hover }};
                                {% unless settings.enable_button_hover %}
                                  background-color:{{ block.settings.bg_button_hover }};
                                {% endunless %}
                              }
                              .btn-outline.btn-{{ block.id }}::before{
                                background-color:{{ block.settings.bg_button_hover }};
                              }
                              .btn-underline.btn-{{ block.id }}{
                                color:{{ block.settings.color_button }} !important;
                                border-bottom-color:  {{ block.settings.color_button }} !important;
                                font-size: 12px;
                              }
                              .btn-underline.btn-{{ block.id }}:hover{
                                color:{{ block.settings.color_button_hover }} !important;
                                border-bottom-color:  {{ block.settings.color_button_hover }} !important;
                              }
                            </style>
                            <div class="grid-banner-btn">
                              <a href="{{ block.settings.button_link }}" class="btn {{ block.settings.style_btn }} btn-{{ block.id }} {% if block.settings.vertical == 'bottom' %}btn-sm{% endif %}">
                                {{ block.settings.button_text }}
                              </a>
                            </div>
                          {%- endif -%}
                        </div>
                      </div>
                    </div>
              </figcaption>		
            </figure>
    
          </div>
        </div>

      {%- endfor -%}
    </div>
  </div>
</div>
</div>

