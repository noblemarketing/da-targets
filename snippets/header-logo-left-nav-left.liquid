<div class="header-top__wrap d-flex w-100">
  <div class="d-flex d-xl-none toggle-menu-mobile align-items-center">
    {%- render 'button-toggle-menu-mobile' -%}
    <span class="modal__toggle-search-mobile" aria-hidden="true" focusable="false" role="presentation">
      {% render 'icon-search' %}
    </span>
  </div>
    <div class="d-flex align-items-center justify-content-center justify-content-xl-start col-logo ">
        <div class="pl-xl-0 ml-xl-0">
        {%- render 'site-logo' -%}
        </div>
    </div>
    <div class="header-bottom__right col-bottom__right">
        <div class="d-none d-xl-flex align-items-center">
            {%- liquid
              assign enable_image = section.settings.enable_image
              assign enable_name = section.settings.enable_name 
              if section.settings.e_hd_currency and localization.available_countries.size > 1
                render 'localization' id: 'HeaderCountryForm', enable_image: enable_image, enable_name: enable_name
              endif
            if section.settings.enable_language_selector and localization.available_languages.size > 1 
                render 'localization-language', id: 'HeaderLanguageForm', enable_name: enable_name
              endif
            -%}
        </div>
        {%- render 'header-search', link_list_search: section.settings.link_list_search, e_search: section.settings.sidebar_search -%}
        {%- render 'header-login' -%}
        {%- render 'block-wishlist' -%}
        {%- render 'block-cart' -%}
    </div>
</div>

<div class="d-none d-xl-flex col-menu">
{%- liquid
    assign main_linklist = section.settings.main_linklist
    assign blocks = section.blocks
-%}
{%- render 'block-menu', main_linklist: main_linklist, blocks: blocks -%}

  {%- for block in section.blocks -%}
    {%- if block.type == 'html-code' -%}
      <style>
        .col-menu_custom {
          align-items: center;
          font-size: 14px;
          text-transform: uppercase;
          font-weight: 700;
          letter-spacing: 2px;
        }
        .col-menu_custom a {
          display: flex;
          align-items: center;
          gap: 7px;
        }
        .col-menu_custom a:not(:last-child) {
          padding-right: 17px;
          margin-right: 17px;
          border-right: 1px solid #00000066;
        }
      </style>
      <div class="col-menu_custom d-lg-flex d-none">
        {% if block.settings.menu_code != blank %}
        <a href="{{ block.settings.menu_link_custom }}" class="col-menu_custom-left">
          {{ block.settings.menu_code }}
        </a>
        {% endif %}
        {% if block.settings.menu_code_2 != blank %}
        <a href="{{ block.settings.menu_link_custom_2 }}" class="col-menu_custom-right">
          {{ block.settings.menu_code_2 }}
        </a>
        {% endif %}
      </div>
    {%- endif -%}
  {%- endfor -%}

</div>
  