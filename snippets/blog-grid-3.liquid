<!-- blog-grid-3.liquid -->
 <style>
  .blog__item--3 .blog_tag:after {
    content: "";
    display: inline-block;
    width: 1px;
    height: 9px;
    vertical-align: middle;
    background-color: var(--color-border);
    margin: 0 10px;
  }
  .blog__item--3 .blog__meta{
    font-size: 11px;
    font-weight: 600;
    line-height: 16px;
  }
 </style>
<div class="blog__item blog__item--3 {% if template contains 'index' %} mb-0 {% else %} mb-5 {% endif %}">
  {%- if article.image -%}
  <div class="content-block__image">
    <a href="{{ article.url }}">
      <noscript>
        {{ article | image_url: width: 1024, height: 1024 | image_tag: article.title | escape }}
      </noscript>
      <div class="article__photo-container">
        <div class="article__photo-wrapper {{ image_size }} " style="padding-top:{{ 1 | divided_by: article.image.aspect_ratio | times: 100 }}%;">
          {%- assign img_url = article.image | image_url: width: 1 | replace: 'width=1', 'width={width}' -%}
          <img class="lazyload scale-in"
               src="{{ article.image | image_url: width: 1, height: 1 }}"
               data-src="{{ img_url }}"
               data-widths="[360, 540, 720, 900, 1080, 1296, 1512, 1728, 2048]"
               data-aspectratio="{{ article.image.aspect_ratio }}"
               data-sizes="auto"
               alt="{{ article.title | escape }}"
               loading="lazy"
               width="{{ article.image.width }}"
               height="{{ article.image.height }}">
        </div>
      </div>
    </a>
  </div>
  {%- endif -%}
  <div class="content-block__meta transition d-flex flex-column justify-content-end align-items-start">
    <div class="d-flex align-items-center text-uppercase mb-13">
      <div style="background-color: #F4F4F4;" class="d-flex align-items-center blog__content-tag-with-date ptb-5 px-9">
        {%- if enable_tag -%}
          {%- if article.tags.size > 0 -%}
            <div class="blog_tag">
              {%- for tag in article.tags -%}
              <a href="{{ blog.url }}/tagged/{{ tag | handle }}" style="color: var(--g-main)">{{ tag }}</a>{% unless forloop.last %}, {% endunless %}
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endif -%}
        {%- if enable_date -%}
        <p style="color: var(--color-accent-4);" class="blog__meta text-uppercase">
          <time datetime="{{ article.published_at }}">
            <span class="meta-b">{{ article.published_at | date: "%b" }}</span>
            <span class="meta-d">{{ article.published_at | date: "%d" }}</span>,
            <span class="meta-y">{{ article.published_at | date: "%Y" }}</span>
          </time>
        </p>
        {%- endif -%}
      </div>
      {%- if enable_comment -%}
      <div style="color: var(--color-accent-3)" class="blog_comment align-items-center d-flex">
        <svg fill="none" focusable="false" width="18" height="17" class="icon-comment mr-2 d-none" viewBox="0 0 18 17">
          <path d="M5 5.5H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M6 8.5H12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M13 13V16L9 13H4C3 13 1 12 1 10V4C1 2 3 1 5 1H13C15 1 17 2 17 4V10C17 12 14.3333 12.8333 13 13Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        {{ 'blogs.comments.with_count' | t: count: article.comments_count }}
      </div>
      {%- endif -%}
    </div>
    <h4 class="blog__title-link text-white mt-2" ><a href="{{ article.url }}">{{ article.title | truncatewords: 10 }}  </a></h4>
    {%- if enable_short -%}
      <div class="rte rte--indented-images mb-4 mt-3 text-white d-none d-lg-block">
        {%- if article.excerpt.size > 0 -%}
          {{ article.excerpt }}
        {%- else -%}
          <p class="text-white">{{ article.content | strip_html | truncatewords: 15 }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
</div>
</div>