<style>
  .quote-top {
    padding: 40px 40px 30px;
  }
  .quote-bottom {
    padding: 14px 40px 12px;
    background-color: #EFEFEF;
  }
  .quote__style_1 .txt-body {
    min-height: 120px;
    max-height: 120px;
    overflow: hidden;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
  }
  .quote__style_1 p {
    font-weight: 700;
    margin: 0 0 9px;
    color: var(--g-color-heading);
  }
  .quote-date {
    font-size: 11px;
    line-height: 16px;
    color: var(--color-accent-4);
    font-weight: 600;
    margin: 3px 0 0;
  }
  .quote__style_1 .h6 {
    font-weight: 500;
    text-transform: capitalize;
    font-style: normal;
  }
</style>

<div class="d-flex {% if aligntext == 'text-center' %} justify-content-center {% endif %} quote__slide quote__style_1 {{ aligntext }} ">
    <div class="quote-wrap"  style="background-color:{{ bg_item }}">

      <div class="quote-top">

        {%- if rate > 0 -%}
          <ul class="rating mb-3">
            {%- for i in (1..5) -%}
              {%- assign iMax = rate -%}
              {%- if i <= iMax -%}
              <li class="rated">
                <svg aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                  {%- else -%}
              <li>
                <svg aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                {%- endif -%}
            {%- endfor -%}   
          </ul>
        {%- endif -%}
        {%- if title != blank -%}
          <p>
            {{ title }}
          </p>
        {%- endif -%}
        <div class=""><div class="{{ size_text }}">{{ quote }}</div></div>

      </div>

      <div class="quote-bottom d-flex align-items-center {% if aligntext == 'text-center' %} justify-content-center {% endif %}">

        {%- if avatar != blank -%}
            <div class="author-avatar mr-3">
              <img class="lazyload" src="{{ avatar | image_url: width: 1 , height: 1 }}" data-src="{{ avatar | image_url: width: 300 }}" 
                loading="lazy"
                width="{{ avatar.width }}"
                height="{{ avatar.height }}"/>
            </div>
        {%- endif -%}

        <div class="text-left">
            <div class="h6">{{ author }}{%- if info != blank -%}
            <span style="color: var(--color-body-text);" class="capitalize small d-block mt-2">  {{ info }}</span>{%- endif -%}
            {%- if date != blank -%}
            <span class="quote-date text-uppercase d-block">  {{ date }}</span>
            {%- endif -%}
          </div>
        </div>

      </div>

    </div>
</div>